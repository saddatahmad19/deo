# ── Anthropic ────────────────────────────────────────────────────────────────
# Used when: provider = "anthropic"
# Models: claude-sonnet-4-6, claude-opus-4-7, claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Used when: provider = "openai"
# Models: gpt-4o, gpt-4o-mini, o1, o3-mini
OPENAI_API_KEY=sk-...

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Used when: provider = "gemini" (or "google_genai")
# Models: gemini-2.5-pro, gemini-2.0-flash
GOOGLE_API_KEY=AIza...

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Used when: provider = "azure"
# model.name should be your deployment name (e.g. "gpt-4o")
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Used when: provider = "openrouter"
# Models: openai/gpt-4o, anthropic/claude-3-5-sonnet, meta-llama/llama-3.1-405b
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── ChromaDB Cloud ────────────────────────────────────────────────────────────
CHROMA_API_KEY=your-chroma-api-key
CHROMA_TENANT=your-tenant-uuid
CHROMA_DATABASE=your-database-name
